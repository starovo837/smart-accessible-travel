{
  "name": "smart-accessible-travel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/assert-plain-copy.mjs && node scripts/assert-travel-copy.mjs && tsc -b && vite build && node scripts/build-offline.mjs",
    "check:travel-copy": "node scripts/assert-travel-copy.mjs",
    "build:pages": "tsc -b && node scripts/build-pages.mjs",
    "build:studio": "node scripts/assert-plain-copy.mjs && tsc -b && node scripts/build-studio.mjs",
    "prepare:studio": "node scripts/prepare-studio.mjs",
    "test": "node --test tests/*.test.mjs",
    "evaluate:ai": "node scripts/evaluate-ai.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@mlc-ai/web-llm": "0.2.85",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.186.1",
    "typescript": "latest",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0"
  }
}
